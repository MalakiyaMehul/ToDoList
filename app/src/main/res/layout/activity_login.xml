<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    tools:context=".activity.RegisterActivity">

    <ImageButton
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:id="@+id/btnImg"
        android:scaleType="fitCenter"
        android:src="@drawable/back_img"
        android:background="@android:color/transparent"
        android:textSize="@dimen/_15sdp"
        android:layout_marginBottom="@dimen/_600sdp"
        android:layout_marginRight="@dimen/_250sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Login"
        android:id="@+id/Login"
        style="@style/TitleTextStyle"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_550sdp"
        app:layout_constraintTop_toBottomOf="@id/btnImg"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        />

   <com.example.todolist.InputField
       android:layout_width="0dp"
       android:layout_height="wrap_content"
       android:id="@+id/txtUserLogin"
       android:layout_marginTop="@dimen/_20sdp"
       android:layout_marginStart="@dimen/_5sdp"
       android:layout_marginEnd="@dimen/_5sdp"
       app:layout_constraintTop_toBottomOf="@+id/Login"
     app:layout_constraintStart_toStartOf="parent"
       app:layout_constraintEnd_toEndOf="parent"/>

    <com.example.todolist.InputField
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:id="@id/edtPassword"
        android:layout_marginTop="@dimen/_20sdp"
        android:layout_marginStart="@dimen/_5sdp"
        android:layout_marginEnd="@dimen/_5sdp"
        app:layout_constraintTop_toBottomOf="@+id/txtUserLogin"
       app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <Button
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:id="@+id/btnLogin"
        android:background="@drawable/register_btn"
        android:text="Login"
        android:textAlignment="center"
        android:textSize="@dimen/_15sdp"
        android:layout_marginTop="@dimen/_60sdp"
        app:layout_constraintTop_toBottomOf="@id/edtPassword"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@+id/btnLogin"
        android:layout_marginStart="@dimen/_20sdp"
        android:layout_marginEnd="@dimen/_20sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:gravity="center"
        android:orientation="horizontal">

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#777777"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:text="or"
            android:textColor="#777777"
            android:textSize="12sp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#777777"/>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/GoogleWithLogin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginTop="@dimen/_50sdp"
        android:background="@drawable/create_btn"
        android:clickable="true"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        >

        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:contentDescription="Google"
            android:scaleType="fitCenter"
            android:src="@drawable/google_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="Register with Google"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_10sdp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/AppleWithLogin"
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:layout_marginTop="@dimen/_15sdp"
        android:background="@drawable/create_btn"
        android:clickable="true"
        android:layout_marginLeft="@dimen/_10sdp"
        android:layout_marginRight="@dimen/_10sdp"
        android:focusable="true"
        android:gravity="center"
        android:orientation="horizontal"
        app:layout_constraintTop_toBottomOf="@id/GoogleWithLogin"
        >

        <ImageView
            android:layout_width="@dimen/_18sdp"
            android:layout_height="@dimen/_18sdp"
            android:contentDescription="Google"
            android:scaleType="fitCenter"
            android:src="@drawable/apple_icon" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/_8sdp"
            android:text="Register with Google"
            android:textColor="#FFFFFF"
            android:textSize="@dimen/_10sdp" />

    </LinearLayout>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Don’t have an account? "
        android:textColor="@color/white"
        android:textAlignment="center"
        android:layout_marginTop="60dp"
        app:layout_constraintTop_toBottomOf="@id/AppleWithLogin"
        android:textSize="@dimen/_10sdp"/>
    <TextView
        android:id="@+id/txtRegistration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Register"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:textAlignment="center"
        android:layout_marginTop="60dp"
        android:layout_marginLeft="@dimen/_140sdp"
        app:layout_constraintTop_toBottomOf="@id/AppleWithLogin"
        android:textSize="@dimen/_10sdp"/>


</androidx.constraintlayout.widget.ConstraintLayout>