<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_calendar_card"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="12dp">

    <!-- Checkbox toggle -->
    <RadioButton
        android:id="@+id/radioSubTaskCompleted"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:background="@drawable/selector_task_radio"
        android:button="@null" />

    <TextView
        android:id="@+id/txtSubTaskTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:fontFamily="sans-serif-medium"
        android:text="Subtask Item"
        android:textColor="@color/white"
        android:textSize="14sp" />

    <ImageView
        android:id="@+id/btnDeleteSubTask"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginStart="8dp"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:contentDescription="Delete Subtask"
        android:padding="4dp"
        android:src="@drawable/trash"
        app:tint="@color/text_muted" />

</LinearLayout>
