<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#111111"
    tools:context=".activity.StartActivity">

    <ImageButton
        android:layout_width="@dimen/_100sdp"
        android:layout_height="@dimen/_100sdp"
        android:id="@+id/btnImg"
        android:scaleType="fitCenter"
        android:src="@drawable/back_img"
        android:background="@android:color/transparent"
        android:textSize="@dimen/_15sdp"
        android:paddingBottom="@dimen/_10sdp"
        android:layout_marginBottom="@dimen/_600sdp"
        android:layout_marginRight="@dimen/_250sdp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>


    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/txtTitle"
        android:text="Welcome to UpTodo"
        android:textSize="@dimen/_30sdp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/btnImg"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_28sdp"
        />

    <TextView
        android:layout_width="@dimen/_250sdp"
        android:layout_height="wrap_content"
        android:id="@+id/txt"
        android:text="Please login to your account or create new account to continue"
        android:textSize="@dimen/_13sdp"
        android:gravity="center"
        android:textColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/txtTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="@dimen/_30sdp"
        />

    <Button
        android:layout_width="match_parent"
        android:layout_height="@dimen/_50sdp"
        android:id="@+id/btnLogin"
        android:background="@drawable/next_btn"
        android:text="LOGIN"
        android:textAlignment="center"
        android:textSize="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@id/txt"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_290sdp"
        />

    <TextView
        android:layout_width="match_parent"
        android:id="@+id/CreateAccount"
        android:layout_height="@dimen/_50sdp"
        android:background="@drawable/create_btn"
        android:text="CREATE ACCOUNT"
        android:textAlignment="center"
        android:textColor="#FFFFFF"
        android:clickable="true"
        android:paddingTop="@dimen/_13sdp"
        android:textSize="@dimen/_15sdp"
        app:layout_constraintTop_toBottomOf="@id/btnLogin"
        android:layout_marginStart="@dimen/_10sdp"
        android:layout_marginEnd="@dimen/_10sdp"
        android:layout_marginTop="@dimen/_20sdp"
        />



</androidx.constraintlayout.widget.ConstraintLayout>